__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
*.db

# Terraform: state holds account ids and emails, tfvars holds the emails the
# accounts are created with. Neither is ever committed; the examples are.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
.terraform.tfstate.lock.info
# A saved plan carries the same ids and emails as the state.
*.tfplan

# Live recordings land here until they are reviewed and moved into fixtures/.
recordings/

# Model answers kept with `eval --answers runs/<name>`, to re-score with --judge answers:runs/<name>.
runs/

# The demo video is built here; only docs/ gets the finished one.
scripts/demo/out/
